# Run artifacts. Every live invocation of run-harness.mjs writes into
# runs/<task-id>/<runtime>--<policy>/<stamp>/, including the extracted
# workdir (a full repo checkout), the trajectory, the diff, the grade, and
# the agent home directory. Large, machine-local, and never committed.
# Reference exemplars live under examples/<workload>/passes/ instead.
runs/

# Antigravity SDK worker venv (gemini_worker.py's interpreter). ~171M of
# machine-local pip packages built per docs/setup.md; it is a build
# artifact, never source. GEMINI_WORKER_PYTHON can point elsewhere, but
# the default in-tree location must never be staged.
sdk-probe/sdkprobe/

# pnpm's content-addressable package store for the SDLC kind's container.
# It lives HERE rather than inside a run's workdir on purpose: pnpm
# requires its store on the same filesystem as node_modules to hardlink,
# and when it is not, pnpm silently relocates the store INTO the project.
# Shared across runs, so it also removes a per-run network fetch. Safe to
# delete at any time; the next run repopulates it.
.pkg-store/

# Python bytecode caches.
__pycache__/
*.pyc
