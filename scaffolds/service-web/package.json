{
  "name": "service-web-scaffold",
  "version": "0.1.0",
  "private": true,
  "description": "The service-web chassis — platform-owned starter every SDLC run receives. Models write ONLY inside src/modules/** and test/modules/** (see CONVENTIONS.md).",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "seed": "prisma db push --skip-generate && node prisma/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^5.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@nestjs/testing": "^10.4.0"
  }
}
