# Build output and deps. packages/*/dist is produced by `pnpm build`.
node_modules/
dist/
*.tsbuildinfo

# Never commit credentials. The harness reads Vertex through gcloud ADC and
# Claude Code through its own login; neither needs a file here.
.env
.env.*
*.json.key
gcs/*.json

# OS noise
.DS_Store

# Run artifacts are ignored by tools/harness-matrix/.gitignore — a run writes
# to tools/harness-matrix/runs/, never into examples/, so nothing here is
# catching stray run output. This block exists for the opposite reason: the
# committed exemplar passes were copied in by hand, and the deny-then-allow
# shape makes that curation explicit. Anything a reader drops under
# examples/<workload>/passes/ is ignored unless it is named below, so an
# unreviewed pass cannot ride along in a commit.
examples/*/passes/*
!examples/*/passes/reference/
!examples/*/passes/reference/**
!examples/swe-bench-pro/passes/navidrome/
!examples/swe-bench-pro/passes/navidrome/**
# The two cost-tier reference passes from the 2026-07-31 live validation
# (scrubbed with scrub-paths.mjs before commit; see CHANGELOG):
!examples/kudos-wall/passes/opus-4.8-plus-gemini-3.5-flash-lite/
!examples/kudos-wall/passes/opus-4.8-plus-gemini-3.5-flash-lite/**
!examples/swe-bench-pro/passes/nodebb/
!examples/swe-bench-pro/passes/nodebb/**

# Local SWE-bench Pro corpus (fetched by tools/swe/fetch-instances-pro.mjs).
# Not committed — fetch is deterministic, and the corpus is large.
studies/swe-pro-corpus/
