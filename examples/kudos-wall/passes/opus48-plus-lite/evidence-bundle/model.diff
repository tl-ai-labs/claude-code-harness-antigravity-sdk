+import { Injectable, BadRequestException } from '@nestjs/common';
+import { PrismaService } from './kudos.prisma';
+import { KudosRecord, FROM_MAX, TO_MAX, MESSAGE_MAX } from './kudos.types';
+
+@Injectable()
+export class KudosService {
+  constructor(private readonly prisma: PrismaService) {}
+
+  async create(body: unknown): Promise<KudosRecord> {
+    if (!body || typeof body !== 'object' || Array.isArray(body)) {
+      throw new BadRequestException('Body must be a plain object');
+    }
+
+    const keys = Object.keys(body);
+    for (const key of keys) {
+      if (key !== 'from' && key !== 'to' && key !== 'message') {
+        throw new BadRequestException(`Unknown key: ${key}`);
+      }
+    }
+
+    for (const key of ['from', 'to', 'message']) {
+      if (!(key in body) || typeof (body as any)[key] !== 'string') {
+        throw new BadRequestException(`Missing or non-string field: ${key}`);
+      }
+    }
+
+    const trimmedFrom = (body as any).from.trim();
+    const trimmedTo = (body as any).to.trim();
+    const trimmedMessage = (body as any).message.trim();
+
+    if (trimmedFrom.length === 0 || trimmedTo.length === 0 || trimmedMessage.length === 0) {
+      throw new BadRequestException('Fields cannot be empty after trimming');
+    }
+
+    if (trimmedFrom.length > FROM_MAX) {
+      throw new BadRequestException(`from exceeds max length of ${FROM_MAX}`);
+    }
+
+    if (trimmedTo.length > TO_MAX) {
+      throw new BadRequestException(`to exceeds max length of ${TO_MAX}`);
+    }
+
+    if (trimmedMessage.length > MESSAGE_MAX) {
+      throw new BadRequestException(`message exceeds max length of ${MESSAGE_MAX}`);
+    }
+
+    return this.prisma.kudos.create({
+      data: {
+        from: trimmedFrom,
+        to: trimmedTo,
+        message: trimmedMessage,
+      },
+    });
+  }
+
+  async list(): Promise<KudosRecord[]> {
+    return this.prisma.kudos.findMany({
+      orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],
+    });
+  }
+}
