+import { Controller, Get, Post, Body, HttpCode } from '@nestjs/common';
+import { KudosService } from './kudos.service';
+import { KudosRecord } from './kudos.types';
+
+@Controller('kudos')
+export class KudosController {
+  constructor(private readonly kudosService: KudosService) {}
+
+  @Post()
+  @HttpCode(201)
+  async create(@Body() body: unknown): Promise<KudosRecord> {
+    return this.kudosService.create(body);
+  }
+
+  @Get()
+  async list(): Promise<KudosRecord[]> {
+    return this.kudosService.list();
+  }
+}
