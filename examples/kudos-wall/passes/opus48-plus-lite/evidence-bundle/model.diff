@@ -0,0 +1,156 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { BadRequestException } from '@nestjs/common';
+import { KudosService } from '../../../src/modules/kudos/kudos.service';
+import { FROM_MAX, TO_MAX, MESSAGE_MAX } from '../../../src/modules/kudos/kudos.types';
+
+class InMemoryPrismaService {
+  public records: any[] = [];
+  private autoId = 1;
+
+  kudos = {
+    create: async ({ data }: { data: { from: string; to: string; message: string } }) => {
+      const record = {
+        id: this.autoId++,
+        from: data.from,
+        to: data.to,
+        message: data.message,
+        createdAt: new Date(),
+      };
+      this.records.push(record);
+      return record;
+    },
+    findMany: async (args?: { orderBy?: any[] }) => {
+      const sorted = [...this.records];
+      if (args?.orderBy) {
+        sorted.sort((a, b) => {
+          for (const ord of args.orderBy) {
+            if (ord.createdAt) {
+              const diff = b.createdAt.getTime() - a.createdAt.getTime();
+              if (diff !== 0) return ord.createdAt === 'desc' ? diff : -diff;
+            }
+            if (ord.id) {
+              const diff = b.id - a.id;
+              if (diff !== 0) return ord.id === 'desc' ? diff : -diff;
+            }
+          }
+          return 0;
+        });
+      }
+      return sorted;
+    },
+  };
+}
+
+describe('KudosService', () => {
+  let service: KudosService;
+  let prismaStub: InMemoryPrismaService;
+
+  beforeEach(() => {
+    prismaStub = new InMemoryPrismaService();
+    service = new KudosService(prismaStub as any);
+  });
+
+  it('rejects non-object bodies (null, string, array)', async () => {
+    await expect(service.create(null)).rejects.toThrow(BadRequestException);
+    await expect(service.create('hello')).rejects.toThrow(BadRequestException);
+    await expect(service.create([])).rejects.toThrow(BadRequestException);
+  });
+
+  it('rejects extra keys (e.g. id)', async () => {
+    await expect(
+      service.create({ from: 'Alice', to: 'Bob', message: 'Great job', id: 123 })
+    ).rejects.toThrow(BadRequestException);
+  });
+
+  it('rejects missing keys', async () => {
+    await expect(service.create({ from: 'Alice', to: 'Bob' })).rejects.toThrow(BadRequestException);
+    await expect(service.create({ to: 'Bob', message: 'Hi' })).rejects.toThrow(BadRequestException);
+    await expect(service.create({ from: 'Alice', message: 'Hi' })).rejects.toThrow(BadRequestException);
+  });
+
+  it('rejects non-string fields', async () => {
+    await expect(
+      service.create({ from: 123, to: 'Bob', message: 'Hi' })
+    ).rejects.toThrow(BadRequestException);
+    await expect(
+      service.create({ from: 'Alice', to: null, message: 'Hi' })
+    ).rejects.toThrow(BadRequestException);
+  });
+
+  it('rejects blank-after-trim fields', async () => {
+    await expect(
+      service.create({ from: '   ', to: 'Bob', message: 'Hi' })
+    ).rejects.toThrow(BadRequestException);
+    await expect(
+      service.create({ from: 'Alice', to: '\t\n', message: 'Hi' })
+    ).rejects.toThrow(BadRequestException);
+    await expect(
+      service.create({ from: 'Alice', to: 'Bob', message: '   ' })
+    ).rejects.toThrow(BadRequestException);
+  });
+
+  it('accepts max lengths (80/80/280) and rejects over-by-one (81/81/281)', async () => {
+    const validFrom = 'a'.repeat(FROM_MAX);
+    const validTo = 'b'.repeat(TO_MAX);
+    const validMsg = 'c'.repeat(MESSAGE_MAX);
+
+    const res = await service.create({ from: validFrom, to: validTo, message: validMsg });
+    expect(res).toBeDefined();
+
+    const invalidFrom = 'a'.repeat(FROM_MAX + 1);
+    await expect(
+      service.create({ from: invalidFrom, to: validTo, message: validMsg })
+    ).rejects.toThrow(BadRequestException);
+
+    const invalidTo = 'b'.repeat(TO_MAX + 1);
+    await expect(
+      service.create({ from: validFrom, to: invalidTo, message: validMsg })
+    ).rejects.toThrow(BadRequestException);
+
+    const invalidMsg = 'c'.repeat(MESSAGE_MAX + 1);
+    await expect(
+      service.create({ from: validFrom, to: validTo, message: invalidMsg })
+    ).rejects.toThrow(BadRequestException);
+  });
+
+  it('trims whitespace around fields (" Ada ")', async () => {
+    const res = await service.create({
+      from: '  Ada  ',
+      to: '  Grace  ',
+      message: '  Awesome work!  ',
+    });
+    expect(res.from).toBe('Ada');
+    expect(res.to).toBe('Grace');
+    expect(res.message).toBe('Awesome work!');
+  });
+
+  it('created record echoes trimmed fields plus a truthy id and a createdAt', async () => {
+    const res = await service.create({
+      from: 'Alice',
+      to: 'Bob',
+      message: 'Thanks',
+    });
+    expect(res.id).toBeTruthy();
+    expect(res.createdAt).toBeInstanceOf(Date);
+  });
+
+  it('list() returns most-recent-first order, empty array when empty, and tie-break by id', async () => {
+    expect(await service.list()).toEqual([]);
+
+    await service.create({ from: 'A', to: 'B', message: 'First' });
+    await service.create({ from: 'C', to: 'D', message: 'Second' });
+    await service.create({ from: 'E', to: 'F', message: 'Third' });
+
+    const listed = await service.list();
+    expect(listed.map(x => x.id)).toEqual([3, 2, 1]);
+
+    // Test tie-break on createdAt: two rows with same createdAt come back highest-id-first
+    const now = new Date();
+    prismaStub.records = [
+      { id: 10, from: 'X', to: 'Y', message: 'A', createdAt: now },
+      { id: 20, from: 'X', to: 'Y', message: 'B', createdAt: now },
+    ];
+    const tied = await service.list();
+    expect(tied.map(x => x.id)).toEqual([20, 10]);
+  });
+});
